<Page
    x:Class="GW40KArmyTracker.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- BattleScribe Data Folder -->
            <StackPanel Spacing="8">
                <TextBlock Text="BattleScribe Data Folder" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Folder containing .cat/.catz catalog files"
                           Style="{ThemeResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           TextWrapping="Wrap" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding DataSourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Select folder with .cat files..." 
                             IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseDataSourceCommand}" />
                </Grid>
            </StackPanel>

            <!-- Rosters Save Folder -->
            <StackPanel Spacing="8">
                <TextBlock Text="Rosters Save Folder" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Where your army rosters will be saved"
                           Style="{ThemeResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding RostersSaveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Select folder for rosters..." 
                             IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseRostersFolderCommand}" />
                </Grid>
            </StackPanel>

            <!-- Default Points Limit -->
            <StackPanel Spacing="8">
                <TextBlock Text="Default Points Limit" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <NumberBox Value="{Binding DefaultPointsLimit, Mode=TwoWay}" 
                           Minimum="500" Maximum="10000" 
                           SpinButtonPlacementMode="Inline" 
                           SmallChange="250" LargeChange="500" />
            </StackPanel>

            <!-- Save Button -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{ThemeResource AccentButtonStyle}" />
                <TextBlock Text="Settings saved!" 
                           VerticalAlignment="Center" 
                           Foreground="Green"
                           Visibility="{Binding IsSaved}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>