<Page
    x:Class="GW40KArmyTracker.Pages.RosterEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:GW40KArmyTracker.Models"
    xmlns:viewmodels="using:GW40KArmyTracker.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24">
        <!-- Roster Selection View - shown when no roster loaded -->
        <Grid Visibility="{x:Bind RosterSelectionVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Select or Create a Roster" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

            <ListView Grid.Row="1" ItemsSource="{x:Bind SavedRosters, Mode=OneWay}" Margin="0,0,0,16">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ArmyRosterViewModel">
                        <Grid Padding="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind RosterName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ArmyName}" Opacity="0.7" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                <Run Text="{x:Bind TotalPoints}"/>
                                <Run Text=" / "/>
                                <Run Text="{x:Bind PointLimit}"/>
                                <Run Text=" pts"/>
                            </TextBlock>
                            <Button Grid.Column="2" Content="Load" Click="LoadSelectedRoster_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="2" Content="New Roster" Click="NewRosterFromList_Click" HorizontalAlignment="Left"/>
        </Grid>

        <!-- Roster Editor View - shown when roster is loaded -->
        <Grid Visibility="{x:Bind RosterEditorVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{x:Bind RosterName}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{x:Bind ArmyName}" FontSize="16" Opacity="0.7"/>
                        <TextBlock>
                            <Run Text="Points:"/>
                            <Run Text="{x:Bind TotalPoints, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="/"/>
                            <Run Text="{x:Bind PointLimit}"/>
                        </TextBlock>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Content="New Roster" Click="NewRosterFromList_Click" VerticalAlignment="Top" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Save Roster" Click="SaveButton_Click" VerticalAlignment="Top"/>
                </Grid>
            </StackPanel>

            <!-- InfoBar -->
            <InfoBar x:Name="SaveConfirmationInfoBar" 
                     Grid.Row="1"
                     Severity="Success" 
                     Title="Roster Saved" 
                     Message="Your roster has been saved successfully."
                     IsOpen="False"
                     Margin="0,0,0,8"/>

            <!-- Content: Two columns instead of three -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Available Units (was Column 2) -->
                <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Available Units" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            
                            <!-- Characters -->
                            <Expander Header="Characters" IsExpanded="True" HorizontalAlignment="Stretch">
                                <ItemsRepeater ItemsSource="{x:Bind Characters, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:Unit">
                                            <Grid Padding="8" DoubleTapped="UnitList_DoubleTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind PointsCost}"/>
                                                    <Run Text="pts"/>
                                                </TextBlock>
                                                <Button Grid.Column="2" Content="Add" Click="AddUnitButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Expander>
                            
                            <!-- Vehicles -->
                            <Expander Header="Vehicles" IsExpanded="True" HorizontalAlignment="Stretch">
                                <ItemsRepeater ItemsSource="{x:Bind Vehicles, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:Unit">
                                            <Grid Padding="8" DoubleTapped="UnitList_DoubleTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind PointsCost}"/>
                                                    <Run Text="pts"/>
                                                </TextBlock>
                                                <Button Grid.Column="2" Content="Add" Click="AddUnitButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Expander>
                            
                            <!-- Squads -->
                            <Expander Header="Squads" IsExpanded="True" HorizontalAlignment="Stretch">
                                <ItemsRepeater ItemsSource="{x:Bind Squads, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:Unit">
                                            <Grid Padding="8" DoubleTapped="UnitList_DoubleTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind PointsCost}"/>
                                                    <Run Text="pts"/>
                                                </TextBlock>
                                                <Button Grid.Column="2" Content="Add" Click="AddUnitButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Expander>
                            
                            <!-- Infantry -->
                            <Expander Header="Infantry" IsExpanded="True" HorizontalAlignment="Stretch">
                                <ItemsRepeater ItemsSource="{x:Bind Infantry, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:Unit">
                                            <Grid Padding="8" DoubleTapped="UnitList_DoubleTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind PointsCost}"/>
                                                    <Run Text="pts"/>
                                                </TextBlock>
                                                <Button Grid.Column="2" Content="Add" Click="AddUnitButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Expander>
                            
                            <!-- Other -->
                            <Expander Header="Other" IsExpanded="True" HorizontalAlignment="Stretch">
                                <ItemsRepeater ItemsSource="{x:Bind Other, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:Unit">
                                            <Grid Padding="8" DoubleTapped="UnitList_DoubleTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind PointsCost}"/>
                                                    <Run Text="pts"/>
                                                </TextBlock>
                                                <Button Grid.Column="2" Content="Add" Click="AddUnitButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Column 2: Current Roster -->
                <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Current Roster" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Grid.Row="1" Margin="0,8">
                            <Run Text="Remaining:"/>
                            <Run Text="{x:Bind RemainingPoints, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="pts"/>
                        </TextBlock>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="(Roster units list coming next)" Opacity="0.5"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>