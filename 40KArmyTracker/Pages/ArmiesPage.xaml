<Page
    x:Class="GW40KArmyTracker.Pages.ArmiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Armies" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Refresh" Click="RefreshButton_Click" />
        </Grid>

        <!-- Status Message -->
        <TextBlock Grid.Row="1" 
                   Text="{Binding StatusMessage}" 
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap" />

        <!-- Main Content -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Faction List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Factions" 
                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                           Margin="0,0,0,8" />

                <ListView x:Name="CatalogListView"
                          Grid.Row="1" 
                          ItemsSource="{Binding GroupedCatalogs}" 
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Expander HorizontalAlignment="Stretch" 
                                      HorizontalContentAlignment="Stretch"
                                      IsExpanded="True">
                                <Expander.Header>
                                    <TextBlock Text="{Binding SuperCategory}" 
                                               FontWeight="Bold" 
                                               FontSize="14"/>
                                </Expander.Header>
                                <ListView ItemsSource="{Binding Catalogs}" 
                                          SelectionMode="Single"
                                          SelectionChanged="CatalogListView_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="20,10,8,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Units.Count}" 
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontSize="12"
                                                           Margin="8,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Battlefield Role -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Battlefield Role" 
                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                           Margin="0,0,0,8" />

                <ListView x:Name="CategoryListView"
                          Grid.Row="1" 
                          ItemsSource="{Binding Categories}" 
                          SelectionMode="Single"
                          SelectionChanged="CategoryListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Padding="8,8" FontSize="13" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Faction Rules -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Faction Rules" 
                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                           Margin="0,0,0,8" />

                <ListView x:Name="FactionRulesListView"
                          Grid.Row="1" 
                          ItemsSource="{Binding FactionRules}" 
                          SelectionMode="Single"
                          SelectionChanged="FactionRulesListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Padding="8,8" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Shared Rules -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Shared Rules" 
                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                           Margin="0,0,0,8" />

                <ListView x:Name="SharedRulesListView"
                          Grid.Row="1" 
                          ItemsSource="{Binding SharedRules}" 
                          SelectionMode="Single"
                          SelectionChanged="SharedRulesListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Padding="8,8" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Units List -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Units" 
                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                           Margin="0,0,0,8" />

                <ListView x:Name="UnitsListView"
                          Grid.Row="1" 
                          ItemsSource="{Binding Units}" 
                          SelectionMode="Single"
                          SelectionChanged="UnitsListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12">
                                    <Run Text="{Binding PointsCost}" />
                                    <Run Text=" pts" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Unit Details / Wargear -->
            <Grid Grid.Column="5">
                <!-- Empty state -->
                <StackPanel x:Name="NoUnitSelectedPanel"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Select a unit to view details" 
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Unit details -->
                <Grid x:Name="UnitDetailsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Unit Name -->
                    <TextBlock Grid.Row="0" 
                               Text="{Binding SelectedUnitName}" 
                               Style="{ThemeResource SubtitleTextBlockStyle}" 
                               Margin="0,0,0,4" />

                    <!-- Base Cost & Keywords -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Base cost: " />
                            <Run Text="{Binding SelectedUnitBaseCost}" />
                            <Run Text=" pts" />
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedUnitKeywords}" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Stat Block -->
                    <Border x:Name="StatBlockPanel"
                            Grid.Row="2"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <TextBlock Text="{Binding StatBlock}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Grid.Row="3" 
                               Text="Wargear Options" 
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,8" />

                    <!-- Wargear List -->
                    <ListView x:Name="WargearListView"
                              Grid.Row="4" 
                              ItemsSource="{Binding WargearOptions}" 
                              SelectionMode="Multiple"
                              SelectionChanged="WargearListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" />
                                        <TextBlock Text="{Binding GroupName}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" 
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12">
                                        <Run Text="+" />
                                        <Run Text="{Binding PointsCost}" />
                                        <Run Text=" pts" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Total Cost -->
                    <Border Grid.Row="5" 
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                       Text="Total Cost" 
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="1" 
                                       Style="{ThemeResource BodyStrongTextBlockStyle}">
                                <Run Text="{Binding TotalCost}" />
                                <Run Text=" pts" />
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Description Panel -->
        <Border Grid.Row="3" 
                x:Name="DescriptionPanel"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="16"
                Margin="0,16,0,0"
                MinHeight="100"
                MaxHeight="180"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding SelectedItemName}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,8" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding SelectedItemDescription}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>